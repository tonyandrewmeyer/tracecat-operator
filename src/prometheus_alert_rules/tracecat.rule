groups:
  - name: tracecat
    rules:
      - alert: TracecatApiDown
        expr: up{job=~".*tracecat.*"} == 0 or tracecat_api_health{status!="ok"} == 1
        for: 2m
        labels:
          severity: critical
        annotations:
          summary: "Tracecat API health check failing"
          description: "The Tracecat API has been failing its health check for more than 2 minutes."

      - alert: TracecatExecutorQueueDepthHigh
        expr: tracecat_executor_queue_depth > 100
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "Tracecat executor queue depth is high"
          description: "Executor queue depth has exceeded 100 for 5 minutes. Consider scaling workers."

      - alert: TracecatNoWorkflowCompleted
        expr: increase(tracecat_workflow_executions_total{status="success"}[30m]) == 0
        for: 30m
        labels:
          severity: warning
        annotations:
          summary: "No Tracecat workflow completed in 30 minutes"
          description: "No workflow has reached SUCCESS in the last 30 minutes — possible dead queue."
